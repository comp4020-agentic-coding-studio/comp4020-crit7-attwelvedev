---
import Base from "../layouts/Base.astro";
---

<Base title="ANU Degree Planner">
  <h1>ANU Degree Planner</h1>
  <p>
    A degree planner for ANU's Bachelor of Advanced Computing (Honours), 2027
    cohort. Place courses onto an 8-semester timeline, and start a plan to
    make it your own — no account needed.
  </p>
  <form method="post" action="/api/plans">
    <button>Start a new plan</button>
  </form>
  <p><a href="/plan/example">See the example plan</a></p>
</Base>
