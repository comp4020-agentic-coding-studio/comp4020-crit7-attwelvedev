---
import "../styles.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="app-shell">
      <nav aria-label="site">
        <a href="/" class="brand">ANU Degree Planner</a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/plan/example">Example plan</a>
          <a href="/help/">Help</a>
          <a href="/readme/">Design notes</a>
        </div>
      </nav>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
