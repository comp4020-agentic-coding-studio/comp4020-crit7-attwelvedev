---
import "../styles.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Home</a>
      <a href="/plan/example">Example plan</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
