---
import "../styles.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Applies saved panel state before first paint so nothing flashes;
      // src/components/panel-state.ts owns these keys (panel-state.test.ts
      // checks they match).
      try {
        var s = localStorage, h = document.documentElement;
        if (s.getItem("panel-nav") === "hidden") h.dataset.nav = "hidden";
        if (s.getItem("panel-reqs") === "collapsed") h.dataset.reqs = "collapsed";
        var w = s.getItem("panel-reqs-w");
        if (/^\d+$/.test(w) && w >= 48 && w <= 4000) h.style.setProperty("--reqs-pref", w + "px");
        var d = s.getItem("panel-details-w");
        if (/^\d+$/.test(d) && d >= 48 && d <= 4000) h.style.setProperty("--details-pref", d + "px");
      } catch (e) {}
    </script>
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="app-shell">
      <nav aria-label="site" id="site-nav">
        <a href="/" class="brand">ANU Degree Planner</a>
        <div class="nav-links">
          <a href="/">Home</a>
          <a href="/plan/example">Example plan</a>
          <a href="/help/">Help</a>
          <a href="/readme/">Design notes</a>
        </div>
        <button type="button" class="nav-hide" aria-controls="site-nav" aria-expanded="true"
          ><svg class="nav-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
            ><path d="m15 6-6 6 6 6"></path></svg
          >Hide navigation</button
        >
      </nav>
      <main>
        {/* In the top bar's layout the tab has no insets, so it sits where main's content starts, which is where every page's title starts; see styles.css. */}
        <button type="button" class="nav-show" aria-controls="site-nav" aria-expanded="false"
          ><svg class="nav-toggle-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
            ><path d="m9 6 6 6-6 6"></path></svg
          ><span class="visually-hidden">Show navigation</span></button
        >
        <slot />
      </main>
    </div>
    <script>
      import { setNavHidden } from "../components/panel-state";

      const root = document.documentElement;
      const show = document.querySelector<HTMLButtonElement>(".nav-show");
      const hide = document.querySelector<HTMLButtonElement>(".nav-hide");
      // The control that was just clicked disappears with the state it
      // described, so focus moves to its counterpart rather than falling back
      // to <body>.
      hide?.addEventListener("click", () => {
        setNavHidden(root, true);
        show?.focus();
      });
      show?.addEventListener("click", () => {
        setNavHidden(root, false);
        hide?.focus();
      });
    </script>
  </body>
</html>
